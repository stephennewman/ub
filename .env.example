# Supabase (project URL + publishable/anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter — used for Claude synthesis (Notes Synthesizer)
OPENROUTER_API_KEY=

# OpenAI — used for Whisper audio transcription only
# (OpenRouter does NOT support audio transcription)
OPENAI_API_KEY=

# Optional: used for OpenRouter attribution headers
NEXT_PUBLIC_APP_URL=

# College Scorecard (api.data.gov key — free signup at https://api.data.gov/signup/)
# Falls back to DEMO_KEY if unset, but DEMO_KEY is rate-limited (30/hr, 50/day).
COLLEGE_SCORECARD_API_KEY=
